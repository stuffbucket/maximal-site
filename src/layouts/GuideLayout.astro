---
import "../styles/global.css";
import { GUIDE_NAV } from "../lib/guide";

interface Props {
  title: string;
  slug?: string;
  description?: string;
  bare?: boolean;
}
const { title, slug, description, bare } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (s: string) => `${base}/guide/${s}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/fraunces-latin.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/commissioner-latin.woff2`}
      crossorigin
    />
    <title>{title} · maximal</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <div class="guide-shell">
      <aside class="guide-sidebar">
        <a class="guide-home" href={`${base}/`}>
          <span class="guide-home__mark" aria-hidden="true">m</span>
          <span class="guide-home__word">maximal</span>
        </a>
        <nav class="guide-nav" aria-label="User guide">
          <p class="guide-nav__label">Guide</p>
          <ul>
            {
              GUIDE_NAV.map((p) => (
                <li>
                  <a
                    href={href(p.slug)}
                    aria-current={p.slug === slug ? "page" : undefined}
                  >
                    {p.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <main id="main" class="guide-main">
        {
          bare ? (
            <slot />
          ) : (
            <article class="prose">
              <slot />
            </article>
          )
        }
      </main>
    </div>

    <style>
      .guide-shell {
        display: grid;
        grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
        gap: var(--space-7);
        max-width: var(--max-width);
        margin: 0 auto;
        padding: var(--space-7) var(--space-5) var(--space-8);
        align-items: start;
      }
      @media (max-width: 820px) {
        .guide-shell {
          grid-template-columns: 1fr;
          gap: var(--space-5);
          padding: var(--space-5) var(--space-4) var(--space-8);
        }
      }

      .guide-sidebar {
        position: sticky;
        top: var(--space-7);
      }
      @media (max-width: 820px) {
        .guide-sidebar {
          position: static;
        }
      }

      .guide-home {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        text-decoration: none;
        margin-bottom: var(--space-6);
      }
      .guide-home__mark {
        display: inline-grid;
        place-items: center;
        width: var(--size-lg);
        height: var(--size-lg);
        border-radius: var(--radius-input);
        background: var(--brand);
        color: var(--brand-ink);
        font-family: var(--font-display);
        font-weight: var(--weight-2xl);
        font-size: var(--text-base);
        line-height: 1;
      }
      .guide-home__word {
        font-family: var(--font-display);
        font-weight: var(--weight-2xl);
        font-size: var(--text-lg);
        letter-spacing: var(--tracking-xl);
        color: var(--text-strong);
      }

      .guide-nav__label {
        font-family: var(--font-body);
        font-size: var(--text-xs);
        font-weight: var(--weight-lg);
        letter-spacing: var(--tracking-caps);
        font-kerning: normal;
        text-transform: uppercase;
        color: var(--text-muted);
        margin: 0 0 var(--space-2);
      }
      .guide-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--space-1);
      }
      .guide-nav a {
        display: block;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-input);
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--text-base-color);
        text-decoration: none;
        transition: background 150ms ease-out, color 150ms ease-out;
      }
      .guide-nav a:hover {
        background: var(--surface-control);
        color: var(--text-strong);
      }
      .guide-nav a:focus-visible {
        outline: var(--focus-ring);
        outline-offset: var(--focus-ring-offset);
      }
      .guide-nav a[aria-current="page"] {
        background: var(--surface-control);
        color: var(--accent);
        font-weight: var(--weight-md);
      }

      .guide-main {
        min-width: 0;
      }

      /* ===== Prose (Design Tokens + Practical Typography) ===== */
      .prose {
        max-width: var(--content-max);
      }
      .prose :global(h1),
      .prose :global(h2),
      .prose :global(h3) {
        hyphens: none;
        font-kerning: normal;
      }
      .prose :global(h1) {
        font-family: var(--font-display);
        font-weight: var(--weight-lg);
        font-optical-sizing: auto;
        font-variation-settings: "SOFT" 30, "opsz" 96;
        font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
        line-height: var(--leading-2xl);
        letter-spacing: var(--tracking-2xl);
        color: var(--text-strong);
        margin: 0 0 var(--space-5);
      }
      .prose :global(h2) {
        font-family: var(--font-display);
        font-weight: var(--weight-lg);
        font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
        line-height: var(--leading-2xl);
        letter-spacing: var(--tracking-2xl);
        color: var(--text-strong);
        margin: var(--space-7) 0 var(--space-3);
      }
      .prose :global(h3) {
        font-family: var(--font-body);
        font-weight: var(--weight-lg);
        font-size: var(--text-lg);
        line-height: var(--leading-xl);
        color: var(--text-strong);
        margin: var(--space-6) 0 var(--space-2);
      }
      .prose :global(p),
      .prose :global(li) {
        color: var(--text-base-color);
        line-height: var(--leading-base);
      }
      .prose :global(p) {
        margin: 0 0 var(--space-4);
      }
      .prose :global(ul),
      .prose :global(ol) {
        margin: 0 0 var(--space-4);
        padding-left: var(--space-5);
      }
      .prose :global(li) {
        margin: var(--space-1) 0;
      }
      .prose :global(li::marker) {
        color: var(--text-muted);
      }
      .prose :global(a) {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 2px;
        text-decoration-thickness: 1px;
        transition: color 150ms ease-out;
      }
      .prose :global(a:hover) {
        color: var(--link-hover);
      }
      .prose :global(strong) {
        color: var(--text-strong);
        font-weight: var(--weight-lg);
      }
      .prose :global(code) {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        background: var(--surface-control);
        border: var(--border-width-hairline) solid var(--border-subtle);
        border-radius: var(--radius-chip);
        padding: 0.05em var(--space-1);
        color: var(--text-strong);
      }
      .prose :global(pre) {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        background: var(--surface-control);
        border: var(--border-width-hairline) solid var(--border-subtle);
        border-radius: var(--radius-input);
        padding: var(--space-3) var(--space-4);
        overflow-x: auto;
        margin: 0 0 var(--space-5);
        line-height: var(--leading-lg);
      }
      .prose :global(pre code) {
        background: transparent;
        border: 0;
        padding: 0;
      }
      .prose :global(blockquote) {
        margin: 0 0 var(--space-5);
        padding: var(--space-1) 0 var(--space-1) var(--space-4);
        border-left: var(--border-width-thick) solid var(--accent);
        color: var(--text-base-color);
      }
      .prose :global(blockquote p:last-child) {
        margin-bottom: 0;
      }
      .prose :global(hr) {
        border: 0;
        border-top: var(--border-width-hairline) solid var(--border-subtle);
        margin: var(--space-7) 0;
      }
      .prose :global(:is(h1, h2, h3) + p) {
        margin-top: 0;
      }
      .prose :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: var(--space-5) 0;
        border: var(--border-width-hairline) solid var(--border-subtle);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
      }
    </style>
  </body>
</html>
