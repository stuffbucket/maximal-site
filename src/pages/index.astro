---
import { getEntry, render } from "astro:content";

import GodRays from "../components/GodRays.astro";
import SocialCard from "../components/SocialCard.astro";
import StarButton from "../components/StarButton.astro";
import "../styles/global.css";

const REPO = "stuffbucket/maximal";
const REPO_URL = `https://github.com/${REPO}`;

// The landing body is authored in Markdoc (src/content/landing/index.mdoc).
// Release-dependent data (download URLs, version label) is resolved inside the
// Hero/Downloads components via the shared, memoized lib/downloads.ts — which
// wraps the unchanged lib/version.ts logic — so this shell stays presentational.
const entry = await getEntry("landing", "index");
const { Content } = await render(entry);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Link-unfurl card (SocialCard): what unfurlers use instead of guessing at the
// first inline <img> (which was grabbing the dashboard shot).
const ogTitle = "maximal · Run Claude Code, Claude Desktop, and Codex on GitHub Copilot";
const ogDescription =
  "Run Claude Code, Claude Desktop, Codex, and shared MCP servers like Work IQ on your GitHub Copilot subscription.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/fraunces-latin.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/commissioner-latin.woff2`}
      crossorigin
    />

    <title>maximal · Run Claude Code, Claude Desktop, and Codex on GitHub Copilot</title>
    <meta
      name="description"
      content="maximal is a local proxy for macOS and Windows that routes Claude Code, Claude Desktop, Codex, and opencode to the models in your GitHub Copilot subscription, and shares MCP servers like Work IQ across your apps."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`}
    />
    <meta
      name="theme-color"
      content="#fafafa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />

    <SocialCard title={ogTitle} description={ogDescription} path="/" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <StarButton />

    <!-- Background: light shafts behind the hero (below <main>) -->
    <GodRays />

    <main id="main">
      <Content />
    </main>

    <!-- Foreground layer: bottom-pinned glass dock -->
    <nav class="dock" aria-label="Page sections">
      <div class="dock-inner">
        <span class="dock-brand">maximal</span>
        <a href="#how">How it works</a>
        <a href="#start">Get started</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/guide`}>Guide</a>
        <a href={REPO_URL} rel="noopener">GitHub</a>
      </div>
    </nav>

    <script is:inline>
      // aria-current on dock links based on viewport scroll position.
      (function () {
        var links = document.querySelectorAll('.dock a[href^="#"]');
        if (!links.length || !("IntersectionObserver" in window)) return;
        var byId = {};
        links.forEach(function (a) {
          byId[a.getAttribute("href").slice(1)] = a;
        });
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              var a = byId[entry.target.id];
              if (!a) return;
              if (entry.isIntersecting) {
                links.forEach(function (l) {
                  l.removeAttribute("aria-current");
                });
                a.setAttribute("aria-current", "page");
              }
            });
          },
          { rootMargin: "-40% 0px -50% 0px", threshold: 0 },
        );
        Object.keys(byId).forEach(function (id) {
          var el = document.getElementById(id);
          if (el) io.observe(el);
        });
      })();
    </script>

    <!-- Runtime download hydration (issue #221): upgrade the baked fallback
         download links + version pills from /updates/manifest.json so a release
         advertises itself with no site rebuild. Bundled (not is:inline) so it
         can import the type-checked, schema-2 parser. Fail-closed. -->
    <script>
      import "../lib/hydrate-downloads";
    </script>
  </body>
</html>
