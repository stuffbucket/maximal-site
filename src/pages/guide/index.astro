---
import GuideLayout from "../../layouts/GuideLayout.astro";
import { GUIDE_NAV } from "../../lib/guide";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const description =
  "Install maximal, connect your GitHub Copilot plan, and turn on Claude Code, Claude Desktop, Codex, and Work IQ.";
---

<GuideLayout title="Guide" description={description} bare>
  <header class="guide-index__head">
    <h1 class="guide-index__title">maximal guide</h1>
    <p class="guide-index__lead">
      Install maximal, sign in with your GitHub Copilot account, turn on
      Claude Code, Claude Desktop, and Codex, and share Work IQ across your
      apps.
    </p>
  </header>

  <ol class="guide-cards">
    {
      GUIDE_NAV.map((p, i) => (
        <li>
          <a class="guide-card" href={`${base}/guide/${p.slug}`}>
            <span class="guide-card__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="guide-card__body">
              <span class="guide-card__title">{p.title}</span>
              <span class="guide-card__blurb">{p.blurb}</span>
            </span>
            <span class="guide-card__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </li>
      ))
    }
  </ol>

  <style>
    .guide-index__head {
      margin-bottom: var(--space-6);
    }
    .guide-index__title {
      font-family: var(--font-display);
      font-weight: var(--weight-lg);
      font-optical-sizing: auto;
      font-variation-settings: "SOFT" 30, "opsz" 96;
      font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
      line-height: var(--leading-2xl);
      letter-spacing: var(--tracking-2xl);
      hyphens: none;
      color: var(--text-strong);
      margin: 0 0 var(--space-3);
    }
    .guide-index__lead {
      font-family: var(--font-body);
      font-size: var(--text-md);
      line-height: var(--leading-base);
      color: var(--text-base-color);
      max-width: var(--content-max);
      margin: 0;
    }

    .guide-cards {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
    @media (max-width: 640px) {
      .guide-cards {
        grid-template-columns: 1fr;
      }
    }

    .guide-card {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      height: 100%;
      padding: var(--space-4);
      background: var(--surface-card);
      border: var(--border-width-hairline) solid var(--border-subtle);
      border-radius: var(--radius-card);
      text-decoration: none;
      color: inherit;
      box-shadow: var(--shadow-card);
      transition:
        border-color 150ms ease-out,
        transform 150ms ease-out,
        background 150ms ease-out;
    }
    .guide-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .guide-card:focus-visible {
      outline: var(--focus-ring);
      outline-offset: var(--focus-ring-offset);
    }

    .guide-card__num {
      flex: 0 0 auto;
      font-family: var(--font-display);
      font-weight: var(--weight-lg);
      font-size: var(--text-base);
      line-height: var(--leading-lg);
      color: var(--accent);
      font-variant-numeric: tabular-nums;
    }
    .guide-card__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      flex: 1 1 auto;
      min-width: 0;
    }
    .guide-card__title {
      font-family: var(--font-body);
      font-weight: var(--weight-lg);
      font-size: var(--text-base);
      color: var(--text-strong);
    }
    .guide-card__blurb {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      line-height: var(--leading-lg);
      color: var(--text-muted);
    }
    .guide-card__arrow {
      flex: 0 0 auto;
      align-self: center;
      color: var(--text-muted);
      transition: color 150ms ease-out;
    }
    .guide-card:hover .guide-card__arrow {
      color: var(--accent);
    }
  </style>
</GuideLayout>
