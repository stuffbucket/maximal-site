---
import { getDownloadInfo } from "../../lib/downloads";
interface Props {
  tagline: string;
  downloadLabel?: string;
}
const { tagline, downloadLabel = "Download for macOS" } = Astro.props;
const { macDmg: downloadUrl, versionLabel, winSetup, hasWindows } =
  await getDownloadInfo();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const linuxUrl = `${base}/guide/install#install-on-linux`;
---

<header class="hero" aria-labelledby="title">
  <span class="hero__watermark" aria-hidden="true">m</span>
  <div class="hero__content">
    <h1 id="title" class="wordmark">maximal</h1>
    <p class="tagline">{tagline}</p>

    <div class="hero-cta">
      {
        downloadUrl && (
          <a
            class="btn btn--primary hero-cta__item"
            data-os="mac"
            href={downloadUrl}
            rel="noopener"
          >
            <span class="btn-label">{downloadLabel}</span>
            {versionLabel && (
              <span class="btn-meta" data-version-pill>
                {versionLabel}
              </span>
            )}
          </a>
        )
      }
      {
        hasWindows ? (
          <a
            class="btn btn--primary hero-cta__item"
            data-os="windows"
            href={winSetup}
            rel="noopener"
          >
            <span class="btn-label">Download for Windows</span>
            {versionLabel && (
              <span class="btn-meta" data-version-pill>
                {versionLabel}
              </span>
            )}
          </a>
        ) : (
          <div
            class="btn btn--soon hero-cta__item"
            data-os="windows"
            aria-disabled="true"
          >
            <span class="btn-label">Windows</span>
            <span class="btn-meta">coming soon</span>
          </div>
        )
      }
      <a class="btn btn--ghost hero-cta__item" data-os="linux" href={linuxUrl}>
        <span class="btn-label">Linux *</span>
      </a>
    </div>
  </div>
</header>

<style>
  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 44rem;
  }

  .hero-cta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-3);
  }
  .hero-cta__item {
    flex: 0 0 auto;
  }

  .hero .btn--ghost {
    background: transparent;
    border-color: color-mix(in srgb, var(--brand-ink) 55%, transparent);
    color: var(--brand-ink);
  }
  .hero .btn--ghost:hover {
    background: color-mix(in srgb, var(--brand-ink) 12%, transparent);
    border-color: var(--brand-ink);
    color: #ffffff;
  }
  .hero .btn--ghost .btn-meta {
    color: var(--brand-ink);
    opacity: 0.8;
  }

  @media (max-width: 560px) {
    .hero-cta,
    .hero-cta__item {
      width: 100%;
    }
  }
</style>
