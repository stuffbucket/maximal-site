  /* The receipt is a picture, so it keeps its own paper and ink in both
     themes. Its torn bottom edge is a zigzag mask. */
  .receipt {
    position: relative;
    padding: var(--space-4) var(--space-4) var(--space-5);
    background: #f5f5f5;
    color: #2a2a2a;
