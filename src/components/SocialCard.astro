---
// Link-unfurl metadata (Open Graph + Twitter) for every page, all showing the
// same card: public/og.png, the old site's hero (maximal #184), the wordmark
// on its red candy-paint card over the god-rays backdrop. It's a frozen
// asset; see scripts/gen-og.mjs before regenerating it.
interface Props {
  title: string;
  description: string;
  /** Path under the site base, e.g. "/" or "/guide/connect-copilot". */
  path: string;
}
const { title, description, path } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = new URL(`${base}/`, Astro.site ?? "https://stuffbucket.github.io").href.replace(/\/$/, "");
const url = `${site}${path}`;
const image = `${site}/og.png`;
const imageAlt =
  "The maximal wordmark on a red card under soft light rays, with the line “Connect the AI tools you use to the models in GitHub Copilot.”";
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content="maximal" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
