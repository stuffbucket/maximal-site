---
// God rays: soft light shafts fanning out from behind the hero card, restored
// from the old site (maximal #175) in the current palette.
//
// - Inlined GLSL + raw WebGL, no libraries.
// - Both themes: the canvas is transparent (premultiplied alpha), so the page
//   shows through between the shafts. Dark mode glows on the near-black page;
//   light mode sets softer, deeper shafts on the pale page.
// - Lights the top of the page only. The canvas fades toward the bottom of
//   the window and out over the first screen of scrolling, so no shaft sits
//   behind body copy; once it has faded out the draw loop stops.
// - Reduced motion draws one still frame. Pauses when the tab is hidden.
//   pointer-events: none, z-index 0: it sits behind <main> (z-index 2).
---

<canvas class="godrays" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("canvas.godrays");
  if (canvas) initGodRays(canvas);

  function initGodRays(canvas: HTMLCanvasElement): void {
    const gl = canvas.getContext("webgl", {
      antialias: false,
      alpha: true,
      premultipliedAlpha: true,
      depth: false,
      powerPreference: "low-power",
    });
    if (!gl) return; // No WebGL: the page background is a fine fallback.

    const vert = `
      attribute vec2 p;
      void main() { gl_Position = vec4(p, 0.0, 1.0); }
    `;

    // Light source just behind the hero card; rays fan out from it. The ray
    // field is layered sines of the angle (each 2π-periodic, so no seam) at
    // irrational-ish frequencies for an irregular look, scrolled slowly.
    // Radial falloff and a soft central glow shape it into shafts.
    const frag = `
      precision highp float;
      uniform vec2 uRes;
      uniform float uTime;
      uniform float uIntensity;
      uniform float uLightY;
      uniform float uLight;
      uniform vec3 uColorA;
      uniform vec3 uColorB;
      uniform vec3 uColorC;

      void main() {
        vec2 uv = gl_FragCoord.xy / uRes;
        float aspect = uRes.x / uRes.y;
        vec2 p = vec2((uv.x - 0.5) * aspect + 0.5, uv.y);

        vec2 light = vec2(0.5, uLightY);
        vec2 d = p - light;
        float dist = length(d);
        float ang = atan(d.y, d.x);

        float t = uTime * 0.55;
        float r = 0.45
          + 0.30 * sin(ang * 7.0  + t)
          + 0.22 * sin(ang * 13.0 - t * 1.4 + 2.1)
          + 0.16 * sin(ang * 23.0 + t * 0.8 + 4.2)
          + 0.10 * sin(ang * 41.0 - t * 0.6 + 1.3);
        r = max(r, 0.0);
        r = pow(r, 2.6);

        float falloff = smoothstep(1.5, 0.05, dist);
        float beams = r * falloff;
        // Fade the beams out at the centre so the convergence reads as a soft
        // glow, not a hard point.
        beams *= smoothstep(0.0, 0.26, dist);
        float glow = smoothstep(0.85, 0.0, dist) * 0.16;

        float v = (beams * 0.85 + glow) * uIntensity;
        // Cyclic blend across the palette by ray angle, so neighbouring shafts
        // differ in hue; drifts slowly over time.
        float g = fract(ang / 6.28318 * 1.2 + uTime * 0.06);
        vec3 hue;
        if (g < 0.33333) hue = mix(uColorA, uColorB, g * 3.0);
        else if (g < 0.66667) hue = mix(uColorB, uColorC, (g - 0.33333) * 3.0);
        else hue = mix(uColorC, uColorA, (g - 0.66667) * 3.0);

        // Premultiplied alpha so the page shows through in both themes.
        vec3 rgb;
        float a;
        if (uLight > 0.5) {
          rgb = hue * 0.82;
          a = clamp(v * 0.8, 0.0, 0.5);
        } else {
          rgb = hue;
          a = clamp(v, 0.0, 1.0);
        }
        gl_FragColor = vec4(rgb * a, a);
      }
    `;

    function compile(type: number, src: string): WebGLShader | null {
      const s = gl!.createShader(type);
      if (!s) return null;
      gl!.shaderSource(s, src);
      gl!.compileShader(s);
      if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) {
        console.warn("godrays shader:", gl!.getShaderInfoLog(s));
        return null;
      }
      return s;
    }

    const vs = compile(gl.VERTEX_SHADER, vert);
    const fs = compile(gl.FRAGMENT_SHADER, frag);
    if (!vs || !fs) return;
    const prog = gl.createProgram();
    if (!prog) return;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      console.warn("godrays link:", gl.getProgramInfoLog(prog));
      return;
    }
    gl.useProgram(prog);

    // One full-screen triangle covering clip space.
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "uRes");
    const uTime = gl.getUniformLocation(prog, "uTime");
    const uIntensity = gl.getUniformLocation(prog, "uIntensity");
    const uColorA = gl.getUniformLocation(prog, "uColorA");
    const uColorB = gl.getUniformLocation(prog, "uColorB");
    const uColorC = gl.getUniformLocation(prog, "uColorC");
    const uLightY = gl.getUniformLocation(prog, "uLightY");
    const uLight = gl.getUniformLocation(prog, "uLight");
    // The palette's teal is darker than the old site's turquoise, so the
    // intensity is higher to give the same light; light mode scales it back
    // (0.8 in the shader) since dark shafts read strongly on a pale page.
    gl.uniform1f(uIntensity, 0.72);
    // The site palette: accent teal, its light tint, brand red.
    gl.uniform3f(uColorA, 0.263, 0.494, 0.537); // #437e89
    gl.uniform3f(uColorB, 0.498, 0.757, 0.824); // #7fc1d2
    gl.uniform3f(uColorC, 0.784, 0.2, 0.29); // #c8334a

    // The shader is cheap; render at 0.85× and DPR-capped, soft enough that
    // the upscale never shows and easy on integrated GPUs and battery.
    const scale = 0.85;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    function resize(): void {
      const w = Math.max(1, Math.round(window.innerWidth * scale * dpr));
      const h = Math.max(1, Math.round(window.innerHeight * scale * dpr));
      canvas.width = w;
      canvas.height = h;
      gl!.viewport(0, 0, w, h);
      gl!.uniform2f(uRes, w, h);
    }

    // The light sits behind the hero card's centre and follows it as the
    // page scrolls.
    const hero = document.querySelector<HTMLElement>(".hero");
    function lightY(): number {
      const vh = window.innerHeight || 1;
      if (!hero) return 0.8;
      const r = hero.getBoundingClientRect();
      return 1 - (r.top + r.height / 2) / vh;
    }

    // Fully lit at the top of the page, gone after one screen of scrolling.
    function visibility(): number {
      const vh = window.innerHeight || 1;
      return Math.min(1, Math.max(0, 1 - window.scrollY / vh));
    }

    const darkMM = window.matchMedia("(prefers-color-scheme: dark)");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const start = performance.now();
    let running = false;
    let rafId = 0;

    function frame(now: number): void {
      const shown = visibility();
      canvas.style.opacity = shown.toFixed(3);
      gl!.uniform1f(uTime, (now - start) / 1000);
      gl!.uniform1f(uLightY, lightY());
      gl!.uniform1f(uLight, darkMM.matches ? 0 : 1);
      gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      if (shown === 0) running = false; // asleep until scrolled back up
      if (running) rafId = requestAnimationFrame(frame);
    }
    function play(): void {
      if (running) return;
      running = true;
      rafId = requestAnimationFrame(frame);
    }
    function pause(): void {
      running = false;
      if (rafId) cancelAnimationFrame(rafId);
    }

    function sync(): void {
      if (document.visibilityState !== "visible") pause();
      else if (reduced) {
        pause();
        frame(performance.now()); // one still frame
      } else if (visibility() > 0) play();
    }

    resize();
    window.addEventListener(
      "resize",
      () => {
        resize();
        if (!running) frame(performance.now());
      },
      { passive: true },
    );
    darkMM.addEventListener?.("change", sync);
    document.addEventListener("visibilitychange", sync);
    // Scrolling back into the lit range wakes the loop; under reduced motion
    // it redraws the still frame so the light keeps tracking the hero.
    let scrollPending = false;
    window.addEventListener(
      "scroll",
      () => {
        if (running || scrollPending) return;
        scrollPending = true;
        requestAnimationFrame(() => {
          scrollPending = false;
          sync();
        });
      },
      { passive: true },
    );

    sync();
  }
</script>

<style>
  /* Fades toward the bottom of the window, so the shafts light the hero and
     the margins around it but never the copy below. */
  canvas.godrays {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
    mask-image: linear-gradient(to bottom, #000 35%, transparent 80%);
  }
</style>
