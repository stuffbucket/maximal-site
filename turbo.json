{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".npmrc",
    ".pnpmfile.cjs",
    ".nvmrc",
    ".bun-version",
    "mise.toml",
    "mise.lock",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build:site": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "docs/guide/**"]
    },
    "test:site": {
      "outputs": []
    }
  }
}